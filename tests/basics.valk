
use valk.time
use mysql

test "Basics" {
    let con = connect() ! {
      println(E.message)
      assert(false)
      return
    }

    let name1 = "valk"
    let name2 = "ctx"
    let r : Array[Map[mysql.Value]] = .{}

    // Setup table
    con.query("CREATE TABLE IF NOT EXISTS `users` (
      `id` int NOT NULL AUTO_INCREMENT,
      `name` varchar(50) DEFAULT NULL,
      PRIMARY KEY (`id`)
    )") ! {
      println(E.message)
      assert(false)
      return
    }

    con.query("TRUNCATE TABLE users") ! { assert(false) return }

    //
    let start = time.mono_us()
    con.query("INSERT INTO users (name) VALUES (:name)", .{ "name" => name1 }) ! {
      println(E.message)
      assert(false)
      return
    }
    assert(con.affected_rows == 1)
    assert(con.last_inserted_id == 1)

    assert(((time.mono_us() - start) / 1000) < 40)
    start = time.mono_us()

    con.query("SELECT * FROM users WHERE name = :name", .{ "name" => name1 }) ! { assert(false) return }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 1)

    assert(((time.mono_us() - start) / 1000) < 10)
    start = time.mono_us()

    con.query("SELECT * FROM users WHERE name = :name", .{ "name" => null }) ! {
      println("ERROR: " + E.message)
      assert(false)
      return
    }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 0)

    assert(((time.mono_us() - start) / 1000) < 10)
    start = time.mono_us()

    con.query("SELECT * FROM users WHERE name = :name", .{ "name" => null }) ! {
      println("ERROR: " + E.message)
      assert(false)
      return
    }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 0)

    assert(((time.mono_us() - start) / 1000) < 10)
    start = time.mono_us()


    con.bind("ids", Array[?uint]{ 1, 2, 3 })
    con.query("SELECT * FROM users WHERE id IN (:ids)") ! {
      println("ERROR: " + E.message)
      assert(false)
      return
    }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 1)

    assert(((time.mono_us() - start) / 1000) < 10)
    start = time.mono_us()

    // Insert next
    con.bind("name", name2)
    con.query("INSERT INTO users (name) VALUES (:name)") ! { assert(false) return }
    assert(con.affected_rows == 1)
    assert(con.last_inserted_id == 2)

    assert(((time.mono_us() - start) / 1000) < 40)
    start = time.mono_us()

    con.bind("ids", Array[uint]{ 1, 2, 3 })
    con.query("SELECT * FROM users WHERE id IN (:ids)") ! { assert(false) return }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 2)

    assert(((time.mono_us() - start) / 1000) < 10)
    start = time.mono_us()

    // Binary protocol: FLOAT / DOUBLE columns and NULL binds
    con.query("DROP TABLE IF EXISTS numbers") ! { assert(false) return }
    con.query("CREATE TABLE numbers (`id` int NOT NULL AUTO_INCREMENT, `f` float DEFAULT NULL, `d` double DEFAULT NULL, PRIMARY KEY (`id`))") ! {
      println(E.message)
      assert(false)
      return
    }
    con.query("INSERT INTO numbers (f, d) VALUES (:f, :d)", .{ "f" => 1.5, "d" => -2.25 }) ! { println(E.message) assert(false) return }
    con.query("INSERT INTO numbers (f, d) VALUES (:f, :d)", .{ "f" => null, "d" => 10000000000.0 }) ! { println(E.message) assert(false) return }
    con.query("SELECT * FROM numbers WHERE id > :id ORDER BY id", .{ "id" => 0 }) ! { println(E.message) assert(false) return }
    r = con.fetch_all() ! { assert(false) return }
    assert(r.length == 2)
    let row1 = r.get(0) ! { assert(false) return }
    let row2 = r.get(1) ! { assert(false) return }
    assert((row1["f"] ?? 0.0).to_float() == 1.5)
    assert((row1["d"] ?? 0.0).to_float() == -2.25)
    assert(!isset((row2["f"] ?? 0.0).to_float_or_null()))
    assert((row2["d"] ?? 0.0).to_float() == 10000000000.0)
}
