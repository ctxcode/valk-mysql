use mysql
use sql

fn sql_db() sql.Db !mysql.Error {
    return mysql.database(connect() !>)
}

test "Through the sql package" {
    let db = sql_db() ! { println(E.message) assert(false) return }
    defer db.close()
    assert(db.dialect == sql.Dialect.mysql)
    assert(db.ping())

    db.exec("DROP TABLE IF EXISTS sql_users") ! { println(E.message) assert(false) return }
    db.exec("CREATE TABLE sql_users (id int NOT NULL AUTO_INCREMENT, name varchar(50), age int, active tinyint(1), PRIMARY KEY (id))") ! {
        println(E.message)
        assert(false)
        return
    }

    let changed = db.exec("INSERT INTO sql_users (name, age, active) VALUES (:name, :age, :active)", .{
        "name" => "Ada"
        "age" => 36
        "active" => true
    }) ! { println(E.message) assert(false) return }
    assert(changed == 1)
    // MySQL keeps the id of the last insert
    assert(db.last_insert_id() == 1)

    db.exec("INSERT INTO sql_users (name, age, active) VALUES (:name, :age, :active)", .{
        "name" => "Bob"
        "age" => 20
        "active" => false
    }) ! { assert(false) return }

    let rows = db.all("SELECT * FROM sql_users ORDER BY id") ! { println(E.message) assert(false) return }
    assert(rows.length == 2)
    let first = rows.get(0) ! { assert(false) return }
    assert((first.get("name") !? sql.Value.null()).to_string() == "Ada")
    assert((first.get("age") !? sql.Value.null()).to_int() == 36)
    // MySQL has no boolean type, so it comes back as the 1 it stores
    assert((first.get("active") !? sql.Value.null()).to_bool())

    assert((db.value("SELECT count(*) FROM sql_users") ! { assert(false) return }).to_int() == 2)
    let one = db.one("SELECT * FROM sql_users WHERE name = :name", .{ "name" => "Bob" }) ! { assert(false) return }
    assert(isset(one))
    if isset(one) : assert((one.get("age") !? sql.Value.null()).to_int() == 20)
    assert(!isset(db.one("SELECT * FROM sql_users WHERE name = :name", .{ "name" => "nobody" }) ! { assert(false) return }))

    // Errors arrive as sql errors, with the server's number kept
    db.exec("INSERT INTO sql_users (id, name) VALUES (1, 'clash')") ! {
        assert(error_is(E.code, constraint))
        assert(E.driver_code == "1062")
    }
    db.exec("SELECT * FROM nothing_here") ! {
        assert(error_is(E.code, syntax))
        assert(E.driver_code == "1146")
    }
    assert((db.value("SELECT count(*) FROM sql_users") ! { assert(false) return }).to_int() == 2)

    db.exec("DROP TABLE sql_users") ! { assert(false) return }
}

test "The builder and migrations against MySQL" {
    let db = sql_db() ! { assert(false) return }
    defer db.close()
    db.exec("DROP TABLE IF EXISTS sql_posts") ! { assert(false) return }
    db.exec("DROP TABLE IF EXISTS schema_migrations") ! { assert(false) return }

    let migrator = sql.Migrator.new(db)
    migrator.add("0001-posts.sql", "CREATE TABLE sql_posts (id int NOT NULL AUTO_INCREMENT, title varchar(50), views int, published tinyint(1), PRIMARY KEY (id));")
    let ran = migrator.migrate() ! { println(E.message) assert(false) return }
    assert(ran.length == 1)
    assert((migrator.migrate() ! { assert(false) return }).length == 0)

    db.insert_into("sql_posts").values(.{ "title" => "first", "views" => 10, "published" => true }).run() ! {
        println(E.message)
        assert(false)
        return
    }
    db.insert_into("sql_posts").values(.{ "title" => "second", "views" => 3, "published" => false }).run() ! { assert(false) return }
    db.insert_into("sql_posts").values(.{ "title" => "third", "views" => 30, "published" => true }).run() ! { assert(false) return }

    let query = db.select("title, views")
    query.from("sql_posts")
    query.where("published", true)
    query.where("views", ">", 5)
    query.order_by("views DESC")
    let rows = query.all() ! { println(E.message) assert(false) return }
    assert(rows.length == 2)
    assert(((rows.get(0) !? .{}).get("title") !? sql.Value.null()).to_string() == "third")

    // OFFSET without LIMIT, which MySQL needs a LIMIT in front of
    let offset_rows = db.select("title").from("sql_posts").order_by("id").offset(1).all() ! {
        println(E.message)
        assert(false)
        return
    }
    assert(offset_rows.length == 2)

    let updated = db.update("sql_posts").set_expression("views", "views + :step", .{ "step" => 1 }).where("published", true).run() ! { assert(false) return }
    assert(updated == 2)
    let deleted = db.delete_from("sql_posts").where("views", "<", 5).run() ! { assert(false) return }
    assert(deleted == 1)

    // Transactions
    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("INSERT INTO sql_posts (title, views, published) VALUES (:title, :views, :published)", .{ "title" => "fourth", "views" => 1, "published" => false }) !>
    }) ! { println(E.message) assert(false) return }
    assert((db.value("SELECT count(*) FROM sql_posts") ! { assert(false) return }).to_int() == 3)

    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("INSERT INTO sql_posts (title, views, published) VALUES (:title, :views, :published)", .{ "title" => "fifth", "views" => 1, "published" => false }) !>
        tx.exec("INSERT INTO nothing_here VALUES (1)") !>
    }) ! {
        assert(error_is(E.code, syntax))
        assert((db.value("SELECT count(*) FROM sql_posts") ! { assert(false) return }).to_int() == 3)
        db.exec("DROP TABLE sql_posts") ! { assert(false) return }
        db.exec("DROP TABLE schema_migrations") ! { assert(false) return }
        return
    }
    assert(false)
}

test "Conditions that mix AND and OR on MySQL" {
    let db = sql_db() ! { assert(false) return }
    defer db.close()
    db.exec("DROP TABLE IF EXISTS sql_mixed") ! { assert(false) return }
    db.exec("CREATE TABLE sql_mixed (id int NOT NULL AUTO_INCREMENT, name varchar(50), role varchar(20), score int, active tinyint(1), PRIMARY KEY (id))") ! {
        println(E.message)
        assert(false)
        return
    }

    let rows = Array[Map[sql.Value]]{
        .{ "name" => "ada",  "role" => "admin",  "score" => 10,               "active" => true }
        .{ "name" => "bob",  "role" => "member", "score" => 150,              "active" => true }
        .{ "name" => "dora", "role" => "admin",  "score" => 30,               "active" => false }
        .{ "name" => "eve",  "role" => "owner",  "score" => sql.Value.null(), "active" => true }
    }
    each rows as row {
        db.exec("INSERT INTO sql_mixed (name, role, score, active) VALUES (:name, :role, :score, :active)", row) ! {
            println(E.message)
            assert(false)
            return
        }
    }

    let found = db.select("name")
        .from("sql_mixed")
        .where("active", true)
        .where_group(fn(w: sql.Conditions) {
            w.where("role", "admin")
            w.or_where("score", ">", 100)
        })
        .order_by("name")
        .all() ! { println(E.message) assert(false) return }
    assert(found.length == 2)
    assert(((found.get(0) !? .{}).get("name") !? sql.Value.null()).to_string() == "ada")

    // A NULL score is found by the group that allows it
    let owners = db.select("name")
        .from("sql_mixed")
        .where("role", "owner")
        .where_group(fn(w: sql.Conditions) {
            w.where("score", ">", 4)
            w.or_where_null("score")
        })
        .all() ! { println(E.message) assert(false) return }
    assert(owners.length == 1)

    db.exec("DROP TABLE sql_mixed") ! { assert(false) return }
}

test "Chunking and rows taken over, on MySQL" {
    let db = sql_db() ! { assert(false) return }
    defer db.close()
    db.exec("DROP TABLE IF EXISTS sql_chunks") ! { assert(false) return }
    db.exec("CREATE TABLE sql_chunks (id int NOT NULL AUTO_INCREMENT, name varchar(50), checked tinyint(1) DEFAULT 0, PRIMARY KEY (id))") ! {
        println(E.message)
        assert(false)
        return
    }
    let i: uint = 0
    while i++ < 120 : db.exec("INSERT INTO sql_chunks (name) VALUES (:name)", .{ "name" => "row " + i }) ! { assert(false) return }

    let pages: Array[uint] = .{}
    let seen = db.select().from("sql_chunks").order_by("id").chunk(50, fn(rows: Array[Map[sql.Value]]) bool !sql.Error {
        pages.append(rows.length)
        return true
    }) ! { println(E.message) assert(false) return }
    assert(seen == 120)
    assert(pages.length == 3)

    let updated = db.select().from("sql_chunks").chunk_by_id("id", 40, fn(rows: Array[Map[sql.Value]]) bool !sql.Error {
        each rows as row {
            db.exec("UPDATE sql_chunks SET checked = 1 WHERE id = :id", .{ "id" => row.get("id") !? sql.Value.null() }) !>
        }
        return true
    }) ! { println(E.message) assert(false) return }
    assert(updated == 120)
    assert((db.value("SELECT count(*) FROM sql_chunks WHERE checked = 1") ! { assert(false) return }).to_int() == 120)

    let rows = db.query("SELECT id FROM sql_chunks ORDER BY id") ! { assert(false) return }
    let row: Map[sql.Value] = .{}
    rows.next(row) ! { assert(false) return }
    db.exec("UPDATE sql_chunks SET checked = 0 WHERE id = 1") ! { assert(false) return }
    rows.next(row) ! {
        assert(error_is(E.code, error))
        assert(E.message.contains("another statement ran"))
        rows.close()
        db.exec("DROP TABLE sql_chunks") ! { assert(false) return }
        return
    }
    assert(false)
}
