
use valk.net
use valk.time

+ fn connect(host: String, user: String, password: String, db: ?String, port: u32) Connection !Error {

    let sock = net.Socket.client(net.SocketType.tcp, host, port.to(u16)) ! throw .connect { message: "Failed to connect to socket" }

    let col_types = Array[uint]{}
    let col_names = Array[String]{}
    let con = Connection {
        con: sock
        host: host
        username: user
        password: password
        db: db
        reader: ByteReader.new("")
        //
        default_column_types: col_types
        default_column_names: col_names
        column_types: col_types
        column_names: col_names
    }
    con.init() !>
    con.password = "" // clear from memory

    return con
}

+ class Connection {
    con: net.Connection
    //
    host: String
    username: String
    password: String
    db: ?String
    // Data in
    data_in: ByteBuffer (.new())
    packet_end: uint (0) // End of the packet `reader` currently views inside data_in (compacted on next recv)
    reader: ByteReader
    // Data out
    packetbuf: ByteBuffer (.new())
    sender: ByteBuffer (.new())
    querybuf: ByteBuffer (.new()) // Reused when rewriting named parameters
    recv_scratch: &mut [u8] ([u8]{ 0 x 1024 }) // Reused socket read buffer
    //
    seqid: u8 (0)
    // Connection info
    con_id : uint (0)
    scaps: uint (0) // Server
    caps: uint (0) // Client
    auth_plugin: String ("")
    auth_data: String ("")
    salt: String ("")
    rsa_public_key: ?String
    //
    ssl_enabled: bool (false)
    + debug: bool (false)
    + debug_bytes: bool (false)
    ~ closed: bool (false)
    //

    fn init() !Error {
        this.handshake_init() !>
        this.check_auth_method() !>
        this.handshake_response() !>
        let count = 0
        while true {
            if count++ > 10 : throw .error { message: "Infinite loop bug" }
            let r = this.reader
            if r.read_byte() == 0 : break
            r.rewind(1)
            // Check error
            this.check_error() !>
            // Check auth switch
            if this.handshake_auth_switch() !> : continue
            // Check for more auth data
            if this.handshake_extra_data() !> : continue
            // Unknown header byte
            this.unsupported()
        }
    }

    fn unsupported() !Error $throw {
        throw .handshake { message: "This package has not implemented all protocols. Unexpected bytes received." }
    }

    fn check_auth_method() !Error {
        // println("method: " + this.auth_plugin)
        if this.auth_plugin != "mysql_native_password"
        && this.auth_plugin != "caching_sha2_password"
        : throw .unsupported { message: "Unsupported authentication method: %{ this.auth_plugin }" }
    }

    fn check_error() !Error {
        let r = this.reader
        let header = r.read_byte()
        if header != 0xFF {
            r.rewind(1)
            return
        }
        // Disable fetch
        this.fetching = false
        this.stop_query()

        // Error code
        r.skip(2)

        if this.caps & CAP.CLIENT_PROTOCOL_41 > 0 {
            // sql_state_marker
            r.read_byte()
            // sql_state
            r.skip(5)
        }

        throw .error { message: r.read_remaining_string() }
    }

    fn recv() !Error {
        let start : uint = 0
        if this.debug : start = time.mono_us()

        let buf = this.data_in
        // Drop the previous packet now that nothing reads from it anymore
        if this.packet_end > 0 {
            buf.clear_until(this.packet_end)
            this.packet_end = 0
        }
        let recv_bytes : uint = buf.length
        while recv_bytes < 4 {
            recv_bytes += this.recv_into_buffer() !>
        }
        if recv_bytes < 4 : throw .error { message: "Invalid MySQL server response (missing packet bytes)" }
        //
        // Packet header: 3 byte little-endian payload length + 1 byte sequence id
        let r = this.reader
        r.reset()
        r.source = buf
        let payload_len : uint = r.read_little_endian(3)
        this.seqid = r.read_byte() + 1
        // Read more if needed
        while recv_bytes < (payload_len + 4) {
            recv_bytes += this.recv_into_buffer() !>
        }
        //
        // Point the reader at the payload in place; the copy-free view stays valid until the next recv()
        r.reset()
        r.source = buf.view(4, payload_len)
        this.packet_end = payload_len + 4
        //
        if this.debug {
            println("RECV SEQ ID: " + (this.seqid - 1))
            if this.debug_bytes : print_bytes(this.reader.source)
            println("Time needed to read: " + ((time.mono_us() - start) / 1000) + "ms")
            println("------")
        }
    }

    fn recv_into_buffer() uint !Error {
        let data = this.recv_scratch
        let count = this.con.read(data) ! throw .error { message: "Failed to read bytes from socket" }
        if count == 0 : throw .error { message: "MySQL server closed the connection" }
        this.data_in.write(data.view(0, count))
        return count
    }

    fn send() !Error {
        let s = this.sender
        let pb = this.packetbuf
        let id = (this.seqid++)
        pb.clear()
        pb.write_little_endian(s.length, 3)
        pb.write_byte(id)
        pb.write(s)
        s.clear() // Clear send data
        //
        let start : uint = 0
        if this.debug {
            start = time.mono_us()
            println("SEND SEQ ID: " + id)
            if this.debug_bytes : print_bytes(pb)
        }
        //
        this.con.write(pb) ! throw .error { message: "Failed to send bytes to server" }
        //
        if this.debug {
            println("Time needed to send: " + ((time.mono_us() - start) / 1000) + "ms")
            println("------")
        }
    }

    fn get_caps() u64 {
        let caps : u64 = CAP.CLIENT_MYSQL | CAP.CLIENT_PROTOCOL_41 | CAP.CLIENT_PLUGIN_AUTH | CAP.CLIENT_PLUGIN_AUTH_LENENC_CLIENT_DATA | CAP.CLIENT_DEPRECATE_EOF | CAP.CLIENT_MULTI_STATEMENTS
        this.caps = caps
        if isset(this.db) : caps |= CAP.CLIENT_CONNECT_WITH_DB
        if isset(this.ssl_enabled) : caps |= CAP.CLIENT_SSL
        return caps
    }

    + fn close() {
        if this.closed : return
        this.closed = true
        this.con.close() ! {}
    }
}
