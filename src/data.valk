// MySQL length-encoded integers, built on the bounds-checked ByteBuffer/ByteReader APIs

extend ByteReader {
    + fn read_int_enc() uint {
        let v = this.read_byte().to(uint)
        if v <= 250 : return v
        if v == 0xFB : return v // NULL marker
        if v == 0xFC : return this.read_little_endian(2)
        if v == 0xFD : return this.read_little_endian(3)
        return this.read_little_endian(8)
    }
}

extend ByteBuffer {
    + fn write_int_encoded(v: uint) uint {
        if v <= 250 {
            this.write_byte(v.to(u8))
        } else if v < (1 << 16) {
            this.write_byte(0xFC)
            this.write_little_endian(v, 2)
        } else if v < (1 << 24) {
            this.write_byte(0xFD)
            this.write_little_endian(v, 3)
        } else {
            this.write_byte(0xFE)
            this.write_little_endian(v, 8)
        }
        return v
    }
}

// Debug helper: prints bytes as "0x..,0x.." like ptr.print_bytes, without raw pointers
fn print_bytes(data: &[u8]) {
    let len = data.length
    let i : uint = 0
    while i < len {
        print("0x")
        (data.get(i) !? 0).print(16)
        if ++i < len : print(",")
    }
    print("\n")
}

// IEEE-754 bit patterns -> floats (binary protocol FLOAT/DOUBLE columns)
fn f32_from_bits(bits: u32) f32 {
    return @ptrv(&bits, f32)
}
fn f64_from_bits(bits: u64) f64 {
    return @ptrv(&bits, f64)
}
