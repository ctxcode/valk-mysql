
use valk.net

extend Connection {

    fn enable_ssl() !Error {
        // Response
        let scaps = this.scaps
        let ccaps = this.get_caps()
        ccaps |=  CAP.CLIENT_SSL
        //
        let ccharset : u8 = 45 // utf8mb4_general_ci

        // Write resp
        let s = this.sender
        // Client caps
        s.write_u32_le(ccaps.to(u32))
        // Max packet size
        s.write_u32_le(0xFFFFFF)
        // Charset
        s.write_byte(ccharset)
        // Filler (0x00 bytes)
        s.fill(0x00, 23)

        //
        this.send() !>
        this.check_error() !>

        let options = this.ssl
        let ssl = net.Ssl.new()
        // The host name is checked along with the chain: ssl_connect names the host connected to
        ssl.set_verify(options.mode == SslMode.verify_full)
        let ca_file = options.ca_file
        if isset(ca_file) : ssl.set_ca_cert(ca_file) ! throw .connect { message: "Cannot read the CA file '" + ca_file + "'" }
        let certificate = options.certificate_file
        if isset(certificate) {
            let key = options.private_key_file ?? certificate
            ssl.set_certificate(certificate, key, options.key_password) ! {
                throw .connect { message: "Cannot use the client certificate '" + certificate + "' with the key '" + key + "'" }
            }
        }
        this.con.ssl_connect(ssl) ! {
            throw .connect { message: "Failed to establish SSL connection: " + ssl.get_error_message() }
        }
        this.ssl_active = true
    }
}
