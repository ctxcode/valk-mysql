/// A statement prepared once on the server and run as often as needed, made by
/// `Connection.prepare`.
///
/// Its values go in by name, as with `Connection.query`, and its rows are read with the fetch
/// methods of the connection. `close` releases it on the server; closing the connection
/// releases them all.
///
/// ```valk
/// let insert = con.prepare("INSERT INTO users (name, age) VALUES (:name, :age)") ! panic("%{E.message}")
/// defer insert.close()
/// each people as person {
///     insert.run(.{ "name" => person.name, "age" => person.age }) ! panic("%{E.message}")
/// }
/// ```
+ class Statement {
    /// The SQL the statement was prepared from.
    ~+ sql: String
    con: Connection
    id: uint
    param_count: uint
    // Per `?`, the name its value is taken from
    names: Array[String]
    ~ closed: bool (false)

    /// Runs the statement with `values` bound to its `:name` placeholders. Rows, if any, are
    /// read with `fetch_row` or `fetch_all` of the connection.
    ///
    /// Every placeholder needs a value; a name without one throws.
    + fn query(values: ?Map[?Value] (null)) !Error {
        this.con.query_prepared(this, values) !>
    }

    /// Runs the statement and returns how many rows it changed. `last_inserted_id` of the
    /// connection holds the id an insert wrote.
    + fn run(values: ?Map[?Value] (null)) uint !Error {
        let con = this.con
        con.query_prepared(this, values) !>
        con.stop_query()
        return con.affected_rows
    }

    /// Releases the statement on the server. Running it afterwards throws.
    + fn close() {
        if this.closed : return
        this.closed = true
        let con = this.con
        if con.closed : return
        if con.in_progress : con.stop_query()
        // COM_STMT_CLOSE, which has no answer
        con.seqid = 0
        con.sender.write_byte(0x19)
        con.sender.write_u32_le(this.id.to(u32))
        con.send() _
    }
}

extend Connection {
    /// Prepares a statement on the server, to run many times with other values each time.
    ///
    /// The server parses the SQL once, here; running the statement only sends its values, and
    /// its rows come back in the binary protocol. Values go in by name, `:name`; a name used
    /// twice takes the same value.
    ///
    /// ```valk
    /// let find = con.prepare("SELECT * FROM users WHERE id = :id") ! panic("%{E.message}")
    /// defer find.close()
    /// find.query(.{ "id" => 1 }) ! panic("%{E.message}")
    /// let users = con.fetch_all() ! panic("%{E.message}")
    /// ```
    + fn prepare(sql: String) Statement !Error {
        if this.closed : throw .error { message: "The connection is closed" }
        if this.in_progress : this.stop_query()
        this.query_serial++
        let names = Array[String]{}
        let text = name_placeholders(sql, names)
        if this.debug : println("Prepare: " + text)
        this.prepare_on_server(text) !>
        let statement = Statement {
            sql: sql
            con: this
            id: this.statement_id
            param_count: this.param_count
            names: names
        }
        if statement.param_count != names.length {
            statement.close()
            throw .error { message: "A prepared statement takes its values by name: use :name instead of ?" }
        }
        return statement
    }

    // Binds `values` to a prepared statement and runs it
    fn query_prepared(statement: Statement, values: ?Map[?Value]) !Error {
        if statement.closed || this.closed : throw .error { message: "The statement is closed" }
        if this.in_progress : this.stop_query()
        let binds = this.final_binds
        binds.clear()
        each statement.names as name {
            let given = values ?! throw .error { message: "No value for the placeholder ':" + name + "'" }
            let value = given.get(name) ! throw .error { message: "No value for the placeholder ':" + name + "'" }
            if !isset(value) {
                binds.append(Value.null())
                continue
            }
            if value.type == TYPE.array : throw .error { message: "A list cannot be bound to the placeholder ':" + name + "' of a prepared statement" }
            binds.append(value)
        }
        this.in_progress = true
        this.query_serial++
        this.is_statement = true
        if this.debug : println("Run prepared: " + statement.sql)
        this.send_execute(statement.id, statement.param_count) !>
        this.fetching = true
        this.check_result_set() !>
    }
}

// Turns the `:name` placeholders of `query` into `?` and adds their names to `names` in order.
// Quoted text and comments are left alone.
fn name_placeholders(query: String, names: Array[String]) String {
    if !query.contains_byte(':') : return query
    let out = ByteBuffer.new(query.length)
    let i: uint = 0
    let len = query.length
    while i < len {
        let ch = query[i++]
        if ch == '\'' || ch == '"' || ch == '`' {
            out.write_byte(ch)
            while i < len {
                let qch = query[i++]
                out.write_byte(qch)
                if qch == '\\' && ch != '`' && i < len {
                    out.write_byte(query[i++])
                    continue
                }
                if qch == ch : break
            }
            continue
        }
        if ch == '#' || (ch == '-' && i + 1 < len && query[i] == '-' && query[i + 1] == ' ') {
            out.write_byte(ch)
            while i < len && query[i] != '\n' : out.write_byte(query[i++])
            continue
        }
        if ch == '/' && i < len && query[i] == '*' {
            let close = query.index_of("*/", i + 1) !? len
            let end = close + 2 > len ? len : close + 2
            out.write(query.view(i - 1, end - (i - 1)))
            i = end
            continue
        }
        if ch == ':' && i < len && (query[i].is_alpha() || query[i] == '_') {
            let start = i
            while i < len && (query[i].is_alpha_numeric() || query[i] == '_') : i++
            names.append(query.range(start, i - start))
            out.write_byte('?')
            continue
        }
        out.write_byte(ch)
    }
    return out.to_string()
}
