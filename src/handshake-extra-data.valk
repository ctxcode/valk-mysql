
extern fn RSA_public_encrypt(len: i32, in: ptr, out: ptr, rsa_public_key: cstring, padding: i32) i32;
extern fn RSA_size(rsa: ptr) i32;
extern fn BIO_new_mem_buf(buf: ptr, len: i32) ?ptr;
extern fn PEM_read_bio_RSA_PUBKEY(bp: ptr, x: ?ptr, cb: ?ptr, u: ?ptr) ?ptr;
extern fn BIO_free(bp: ptr);

value RSA_PKCS1_OAEP_PADDING (4)

extend Connection {

    fn handshake_extra_data() bool !Error {
        let r = this.reader
        if r.read_byte() != 0x01 {
            r.rewind(1)
            return false
        }
        // Further auth data required
        if this.auth_plugin == "caching_sha2_password" {
            let byte = r.read_byte()
            if byte == 0x03 {
                // Fast auth ok, receive ok packet
                this.recv() !>
                return true
            } else if byte == 0x04 {
                // Fast auth failed, full auth required
                if this.ssl_enabled {
                    // Send plain password + 0x00 byte
                    let s = this.sender
                    s.write(this.password)
                    s.write_byte(0)
                    this.send() !>
                    // Receive OK
                    this.recv() !>
                    return true
                }
                // No SSL: use RSA encrypted password
                // Step 1. Request public key (unless you already have it)
                let key = this.rsa_public_key
                if !isset(key) {
                    let s = this.sender
                    s.write_byte(0x02)
                    this.send() !>
                    // Receive key
                    this.recv() !>
                    this.check_error() !>
                    if r.read_byte() != 0x01 : throw .error { message: "Invalid RSA key response from the mysql server" }
                    key = r.read_remaining_string()
                    this.rsa_public_key = key
                }
                // Step 2 + 3. Encrypt password straight into the send buffer and send it
                this.write_rsa_encrypted_password(key, this.sender) !>
                this.send() !>
                // Receive OK
                this.recv() !>
                return true
            }
        }
        this.unsupported()
    }

    // Password XOR'd with the scramble, zero-terminated, then RSA/OAEP encrypted with the server key.
    // Uses `packetbuf` as scratch (it is only used inside send()), so nothing is allocated.
    fn write_rsa_encrypted_password(key: String, to: ByteBuffer) !Error {
        let scramble = this.salt
        let scramble_len = scramble.length
        let password = this.password
        let in = this.packetbuf
        in.clear()
        let in_len = password.length + 1 // Include the 0x00 terminator (password[len] reads as 0)
        let i : uint = 0
        while i < in_len {
            in.write_byte(password[i] ^ scramble[i % scramble_len])
            i++
        }
        rsa_public_encrypt(key, in, to) !>
        in.clear()
    }
}

// Encrypts `in` with the PEM public key and appends the ciphertext to `out`
fn rsa_public_encrypt(key: String, in: ByteBuffer, out: ByteBuffer) !Error {
    @unsafe
    let bio = BIO_new_mem_buf(key.data, key.length.to(i32))
    if !isset(bio) : throw .error { message: "Failed to allocate RSA key buffer" }
    let rsa = PEM_read_bio_RSA_PUBKEY(bio, null, null, null)
    BIO_free(bio)
    if !isset(rsa) : throw .error { message: "Failed to parse MySQL RSA public key" }
    let out_len = RSA_size(rsa).to(uint)
    out.reserve(out_len)
    let res = RSA_public_encrypt(in.length.to(i32), in.data, out.data.@offset(out.length), rsa, RSA_PKCS1_OAEP_PADDING)
    if res <= 0 : throw .error { message: "Failed to encrypt password using the mysql RSA public key" }
    out.advance(res.to(uint))
}
