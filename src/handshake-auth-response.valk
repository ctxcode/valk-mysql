
use valk.crypto

extend Connection {

    // Writes the auth response bytes for the current auth plugin into `to` (no allocations)
    fn write_auth_response(to: ByteBuffer) {
        let method = this.auth_plugin
        if method == "mysql_native_password" {
            let hash = crypto.Sha1{}
            let hash1: [u8 x 20] = @undefined
            let hash2: [u8 x 20] = @undefined
            let hash3: [u8 x 20] = @undefined

            hash.update(this.password)
            hash.finish(&hash1)

            hash.reset()
            hash.update(&hash1)
            hash.finish(&hash2)

            hash.reset()
            hash.update(this.salt)
            hash.update(&hash2)
            hash.finish(&hash3)

            let i : uint = 0
            while i < 20 {
                to.write_byte(hash1[i] ^ hash3[i])
                i++
            }
            return

        } else if method == "caching_sha2_password" {
            let hash = crypto.Sha256{}
            let hash1: [u8 x 32] = @undefined
            let hash2: [u8 x 32] = @undefined
            let hash3: [u8 x 32] = @undefined
            hash.update(this.password)
            hash.finish(&hash1)
            hash.reset()
            hash.update(&hash1)
            hash.finish(&hash2)
            hash.reset()
            hash.update(&hash2)
            hash.update(this.salt)
            hash.finish(&hash3)
            let i : uint = 0
            while i < 32 {
                to.write_byte(hash1[i] ^ hash3[i])
                i++
            }
            return
        }
        panic("Bug: Unhandled MySQL authentication method: " + method)
    }
}
